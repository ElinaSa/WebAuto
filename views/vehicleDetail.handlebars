 <div class="container">
    <img class="vehicle-detail-image" src="images/{{rekisterinumero}}.png" alt="Auto">
    <h1 class="big-text align-center">{{rekisterinumero}}</h1>
    <div class="alignment-box">
        <table class="drive-information">
            <tr>
                <td class="drive-information"><svg class="icon-huge icon-raseko-colors"><use href="icons/webAutoSprites.svg#driver" /></svg></td>
                <td class="big-text drive-information">{{kuljettaja}}</td>
            </tr>
            <tr>
                <td class="drive-information"><svg class="icon-huge icon-raseko-colors"><use href="icons/webAutoSprites.svg#reason" /></svg></td>
                <td class="big-text drive-information">{{tarkoitus}}</td>
            </tr>
            <tr>
                <td class="drive-information"><svg class="icon-huge icon-raseko-colors"><use href="icons/webAutoSprites.svg#time" /></svg></td>
                <td class="big-text drive-information">{{otto}}</td>
            </tr>
        </table>
        </div>
    </div>

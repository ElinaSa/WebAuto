<body>
<!-- Simulate a smartphone / tablet -->
<div class="mobile-container">

<!-- Top Navigation Menu -->
<div class="topnav">
  <a href="#home" class="active">Seuranta</a>
  <div id="myLinks">
    <a href="/vehiclelist">Ajoneuvot</a>
    <a href="/diary">Ajopäiväkirjat</a>
    <a href="/filterDiary">Ajopäiväkirjahaku</a>
    <a href="#">Kirjaudu ulos</a>
  </div>

  <a href="javascript:void(0);" class="icon"  onclick="myFunction()"><img src="/icons/menu.svg" alt="icon">
    <i class="fa fa-bars"></i>
  </a>
</div>
 
 {{{body}}}
<script>
function myFunction() {
  var x = document.getElementById("myLinks");
  if (x.style.display === "block") {
    x.style.display = "none";
  } else {
    x.style.display = "block";
  }
}
</script>
    
    
    
    <!-- Main container of the page is card-group -->
    <div class="card-group">

        <!-- Loop through vehicle list and render dynamic data -->
        {{#each vehicleList}}

        <!-- Create a card for every vehicle and set style according to status -->
        <div class="card-{{status}}"><img class="vehicle-image" src="/images/{{rekisterinumero}}.png" />
            <div class="card-body">
                <h4 class="card-title">{{rekisterinumero}} <br>on {{status}}</h4>
                <p class="card-text">{{merkki}} {{malli}}<br />henkilömäärä {{henkilomaara}}<br />
                {{#if automaatti}} 
                automaattivaihteet
                {{else}}
                manuaalivaihteet
                {{/if}}
                </p>
                    

                {{#if ajossa}}
                <a class="{{status}}-btn" href="http://localhost:8080/vehicleDetail?register={{rekisterinumero}}">Näytä</a>
                {{else}}
                <a class="{{status}}-btn" href="http://localhost:8080/vehicleDiary?register={{rekisterinumero}}">Näytä</a>
                {{/if}}                 
                                                                                                                                
            </div>
        </div>
        {{/each}}
    </div>
</body>

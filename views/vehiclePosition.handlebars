<body>   
    
    <div>
    {{> menu}}
    </div> 

    <div class="container">

        <div id="map">
            
            <h1 id="register" class="modern-header">{{register}}</h1>

            {{!-- <div id="routeInfo" class="alignment-box"></div> --}}

            {{!-- It is very important to define height for the map and give a id for it --}}
            <div class="map-frame" id="mapid"></div>

            <script>

                const loadJsonData = async () => {

                    // Haetaan rekisterinumero sivulta
                    const register = document.getElementById('register').innerHTML.trim();

                    // Kutsutaan backendin APIa
                    const apicall = '/api/vehiclePositionData?register='
                    + encodeURIComponent(register);

                    console.log('Kutsutaan:', apicall);

                    const response = await fetch(apicall);

                    // Tarkistetaan että backend vastasi onnistuneesti
                    if (!response.ok) {
                        const errorText = await response.text();

                        console.error(
                            'Backend-virhe:',
                            response.status,
                            errorText
                        );
                        return;
                    }

                    // Backend palauttaa JSONin.
                    // response.json() muuttaa sen suoraan JavaScript-olioksi.
                    const data = await response.json();

                    console.log('Backendistä saatu data:', data);

                    // Haetaan koordinaatit
                    const latitude = data.lat;
                    const longitude = data.lon;

                    // Tarkistetaan että koordinaatit löytyvät
                    if (latitude == null || longitude == null) {
                        console.error(
                            'Sijaintidatasta puuttuu lat tai lon:',
                            data
                        );
                        return;
                    }

                    console.log(
                    'Sijainti:',
                    latitude,
                    longitude
                    );

                    // Luodaan Leaflet-kartta
                    const rasekomap = L.map('mapid').setView(
                        [latitude, longitude],
                        16
                    );

                    // OpenStreetMap-karttataso
                    L.tileLayer(
                        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                        {
                            attribution:
                            'Map data © <a href="https://openstreetmap.org">OpenStreetMap</a> contributors',
                            maxZoom: 19
                        }
                    ).addTo(rasekomap);

                    // Luodaan auton merkki
                    const marker = L.marker(
                        [latitude, longitude]
                    ).addTo(rasekomap);

                    // Näytetään rekisterinumero popupissa
                    marker.bindPopup(
                        `<strong>${register}</strong><br>
                        Leveysaste: ${latitude}<br> Pituusaste: ${longitude}`
                    ).openPopup();

                };

                // Käynnistetään sijainnin haku
                loadJsonData();

            </script>
        </div>
    </div>
</body>
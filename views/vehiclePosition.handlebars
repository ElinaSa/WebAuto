<head>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        #mapid {
            height: 400px;
            width: 100%;
        }
    </style>
</head>


<body>

    <div>
        {{> menu}}
    </div>

    <div class="container">
        <div id="map">
            <h1 class="modern-header">Auton sijainti</h1>
            <h1 id="register" class="modern-header">{{register}}</h1>

            <!-- Kartta -->
            <div id="mapid"></div>

            <script>
                async function loadJsonData() {

                    // Hae rekisterinumero DOM:ista
                    let queryRegister = document.getElementById('register').innerHTML;

                    // API-kutsu
                    let apicall = '/api/vehiclePositionData?register=' + queryRegister;

                    let data;

                    try {
                        const response = await fetch(apicall);
                        data = await response.json();
                    } catch (err) {
                        console.log("API ei vastaa → käytetään placeholder-sijaintia");

                        // Fallback (Turku)
                        data = {
                            lat: 60.4518,
                            lon: 22.2666,
                            register: queryRegister
                        };
                    }

                    // Ota koordinaatit
                    let latitude = data.lat;
                    let longitude = data.lon;

                    // Luo kartta
                    let rasekomap = L.map('mapid').setView([latitude, longitude], 16);

                    // Taustakartta
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: 'Map data © OpenStreetMap contributors',
                        maxZoom: 19,
                    }).addTo(rasekomap);

                    // MARKER
                    let marker = L.marker([latitude, longitude]).addTo(rasekomap);
                    marker.bindPopup(data.register);
                }

                loadJsonData();
            </script>

        </div>
    </div>

</body>
